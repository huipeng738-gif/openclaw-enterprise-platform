JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set false only for local HTTP development; production HTTPS must use true.
REFRESH_COOKIE_SECURE=true
# Public frontend origin (e.g. https://ai.example.com) when TLS terminates at a proxy.
AUTH_ORIGIN=
OPENCLAW_GATEWAY_TOKEN=replace-with-the-gateway-shared-token
OPENCLAW_GATEWAY_URL=wss://your-openclaw-gateway-host
PLUGIN_SERVICE_TOKEN=replace-with-another-random-secret
ALLOWED_AGENTS=coordinator,researcher,writer,reviewer
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=30
RAGFLOW_DATASET_IDS=
